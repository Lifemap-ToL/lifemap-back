(logging_back) {
        log {
                output file /var/log/caddy/access_back.log
        }
}

{
    order rate_limit before basicauth
    order cache before rewrite
    # debug
    # log {
    #     level debug
    # }
    cache {
        allowed_http_verbs GET
        api {
            prometheus
            souin
        }
        ttl 1d
        timeout {
            backend 10s
            cache 200ms
        }
        default_cache_control public
    }
}


{{ backend_hostname }} {

    import logging_back

    encode zstd gzip

    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
    }

    @options {
        method OPTIONS
    }

    rate_limit {
        zone tiles {
            match {
                path /api/v1/tiles/* /vector_tiles/*
                not path /api/v1/tiles/*
            }
            key    {client_ip}
            events 200
            window 1s
        }
        zone api {
            match {
                path /api/* /solr/*
            }
            key    {client_ip}
            events 20
            window 1s
        }
        zone static {
            match {
                path /static/*
            }
            key    {client_ip}
            events 20
            window 1m
        }
    }


    # --- API ---

    redir /api /api/
    handle /api/* {
        cache {
            ttl 1h
        }
        reverse_proxy 127.0.0.1:8081
        respond @options 204
    }


    # --- SOLR ---

    redir /solr /solr/
    handle /solr/* {
        header Cache-Control "public, max-age=300"
        reverse_proxy 127.0.0.1:8983
        # Solr doesn't respond correctly to OPTIONS,
        # which can lead to CORS errors
        respond @options 204
    }

    # --- BBOX ---

    handle_path /vector_tiles/* {
        header Cache-Control "public, max-age=1800"
        # Only cache composite vector tiles from zoom levels 0 to 8
        @cacheable {
            path_regexp ^/xyz/composite/[0-8]/.*$
        }
        handle @cacheable {
            cache {
                ttl 1d
            }
            header Cache-Control "public, max-age=1800"
        }
        reverse_proxy 127.0.0.1:8080
    }

    # --- STATIC / METADATA ---

    handle /data/* {
        redir https://{{ backend_hostname }}/static/{uri}
    }

    handle_path /static/* {
        header Cache-Control "public, max-age=3600"
        root /static
        file_server
    }


    # --- TEST FRONTEND ---

    redir /bbox /bbox/

    handle_path /bbox/* {
        root /front/bbox/dist
        file_server
    }

    # --- HEALTH ENDPOINT ---

    handle /health {
        respond "OK" 200
    }

}



{% if add_lyon1_redirections | default(false) | bool %}

# REDIRECTIONS

lifemap.univ-lyon1.fr, lifemap-ncbi.univ-lyon1.fr, lifemap-fr.univ-lyon1.fr,
lifemap.univ-lyon1.fr:80, lifemap-ncbi.univ-lyon1.fr:80, lifemap-fr.univ-lyon1.fr:80  {


    # Redirection links from NCBI website
    @root_tid {
        path /
        query tid=*
    }
    handle @root_tid {
        redir https://lifemap.cnrs.fr/tree?tool=search&tid={query.tid} 301
    }

    # Redirection links from Weedipedia / Bioindication
    @query_tid {
        path /lifemap-query*
        query tid=*
    }
    handle @query_tid {
        redir https://lifemap.cnrs.fr/tree?tool=subtree&subtree={query.tid} 301
    }


    handle /* {
        redir https://lifemap.cnrs.fr/ 301
    }

}

{% endif %}
